VITE_MAIN_ORIGIN=http://localhost:5173
VITE_AUTH_CLIENT_ID=vetify-anatomy
VITE_AUTH_CALLBACK_URL=http://localhost:5176/auth/callback

# Server-only placeholders. Main does not yet provide this OIDC integration.
OIDC_ISSUER=
OIDC_CLIENT_SECRET=
SESSION_ENCRYPTION_KEY=
ANATOMY_SERVER_PORT=5177
ANATOMY_PRIVATE_ASSET_DIR=private-assets/anatomy

# Vercel private picture storage. These values stay server-side.
BLOB_READ_WRITE_TOKEN=
ANATOMY_BLOB_PREFIX=anatomy/

# The localhost URLs and ANATOMY_SERVER_PORT above are for local development.
# In Vercel project settings, use main Vetify's HTTPS URL for VITE_MAIN_ORIGIN.
# Production VITE_AUTH_CALLBACK_URL=https://anatomy.vetify.page/auth/callback
# Vercel sets VERCEL=1 and runs api/index.ts without a listening port.

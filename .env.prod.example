VITE_MAIN_ORIGIN=https://vetify.page
VITE_AUTH_CLIENT_ID=vetify-anatomy
VITE_AUTH_CALLBACK_URL=https://anatomy.vetify.page/auth/callback

# Main must implement its OIDC provider before these values are available.
OIDC_ISSUER=
OIDC_CLIENT_SECRET=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=

# Server-only MongoDB credentials scoped to the Anatomy database.
MONGODB_URI=
MONGODB_DATABASE=vetify_anatomy
ANATOMY_GRIDFS_BUCKET=anatomy

# The upload:diagrams command reads .env.prod. Vite uses .env.production.
# Set these values in Vercel Production environment variables for deployment.

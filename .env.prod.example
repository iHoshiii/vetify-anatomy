VITE_MAIN_ORIGIN=https://vetify.page
VITE_AUTH_CLIENT_ID=vetify-anatomy
VITE_AUTH_CALLBACK_URL=https://anatomy.vetify.page/auth/callback

# Server-only values from main's implemented OIDC provider.
OIDC_ISSUER=
OIDC_CLIENT_SECRET=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=

# Connect a private Blob store in Vercel, or provide its server-only token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
ANATOMY_BLOB_PREFIX=anatomy/

# Reference template only. Vite loads .env.production, not .env.prod.
# Set these values in Vercel Production environment variables for deployment.

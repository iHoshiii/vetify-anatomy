{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": false },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/anatomy/:path*", "destination": "/api/index" },
    { "source": "/dog/:system", "destination": "/index.html" },
    { "source": "/cat/:system", "destination": "/index.html" },
    { "source": "/bird/:system", "destination": "/index.html" }
  ]
}

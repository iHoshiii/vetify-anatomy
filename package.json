{
  "name": "vetify-anatomy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "concurrently -k -n ui,auth \"vite\" \"npm:dev:server\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs && node --import tsx scripts/smoke-build.mjs",
    "preview": "concurrently -k -n ui,auth \"vite preview\" \"npm:serve:server\"",
    "serve:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "npm run serve:server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "manifest": "node scripts/asset-manifest.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@floating-ui/react": "^0.27.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
